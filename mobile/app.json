{
  "expo": {
    "name": "HealthCare",
    "slug": "healthcare-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D9F6F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.healthcare.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D9F6F"
      },
      "package": "com.healthcare.mobile"
    },
    "plugins": ["expo-router"]
  }
}
